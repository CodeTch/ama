{
  "name": "ama-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../contracts/openapi/api.yaml -o src/shared/api/generated.ts",
    "check:api": "node scripts/check-api.mjs",
    "capture:prototype": "node scripts/capture-prototype.mjs"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-vue": "6.0.4",
    "@types/node": "22.19.15",
    "openapi-typescript": "7.13.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.2.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
