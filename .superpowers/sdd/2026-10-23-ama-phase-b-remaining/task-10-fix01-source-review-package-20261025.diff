+from pathlib import Path
+import shlex,re,json,subprocess,hashlib
+P=Path(__file__).resolve().parents[4];A=Path(__file__).resolve().parent
+# Private values exist only in this process. No values or individual value digests are emitted.
+def envfile(path):
+ values={}
+ for raw in path.read_text().splitlines():
+  line=raw.strip()
+  if line.startswith('export '):line=line[7:]
+  if not line or line.startswith('#') or '=' not in line:continue
+  key,value=line.split('=',1);values[key.strip()]=shlex.split(value)[0]
+ return values
+old=envfile(P/'.tools/phase-b-remaining/env.sh')
+s3=envfile(P/'.tools/task05-5237a2db-e8d5-4cbe-b357-b35df5cfcba5/client.env')
+values={old['AMA_TEST_DATABASE_PASSWORD'].encode(),s3['AMA_S3_ACCESS'].encode(),s3['AMA_S3_SECRET'].encode(),(P/'.tools/task05-5237a2db-e8d5-4cbe-b357-b35df5cfcba5/pki/keystore-password').read_bytes().strip()}
+for name in ['root.cnf','test.cnf']:values.add(envfile(P/'.tools/task08-848e93aace8b4f0fa34fc548267f3dc5/secrets'/name)['password'].encode())
+assert len(values)==6,'Known-value input cardinality changed'
+provider09=list((P/'.tools/task09-2d0e28ea775540f8b3525f9344edf5f0').rglob('provider.secret'))
+provider10=list((P/'.tools/task10-1e48b41fc5c84a98af3a14b51b17884f').rglob('provider.secret'))
+provider=provider09+provider10
+for f in provider:
+ assert f.is_file() and not f.is_symlink() and f.stat().st_mode&511==384
+ values.add(f.read_bytes().strip())
+assert all(len(v)>3 for v in values)
+pattern=re.compile(b'-----BEGIN '+b'(?:[A-Z0-9 ]*PRIVATE KEY|OPENSSH PRIVATE KEY)-----')
+
+# New payload inventory binds every public staged path to mode/OID/size. Attestations are
+# excluded from their own recursive inventory and scanned as exact generated bytes below.
+attestations={str((A/'private-scan.json').relative_to(P)),str((A/'scan-membership.json').relative_to(P))}
+staged=[s for s in subprocess.check_output(['git','diff','--cached','--name-only','-z'],cwd=P).decode().split('\0') if s]
+assert staged and all(not s.startswith('.tools/') for s in staged)
+expected=set((A/'own-stage-pathspec').read_text().splitlines())-attestations
+assert set(staged)-attestations==expected,'Exact payload stage differs from own allowlist'
+selected=set(staged)-attestations;entries=[];objects={}
+for entry in subprocess.check_output(['git','ls-files','--stage','-z'],cwd=P).split(b'\0'):
+ if not entry:continue
+ meta,name=entry.split(b'\t',1);path=name.decode()
+ if path in selected:
+  mode,oid,stage=meta.split();assert stage==b'0';entries.append({'path':path,'mode':mode.decode(),'oid':oid.decode()});objects[oid]=None
+hits=0;pem=0;total=0
+with subprocess.Popen(['git','cat-file','--batch'],cwd=P,stdin=subprocess.PIPE,stdout=subprocess.PIPE) as git:
+ for oid in sorted(objects):
+  git.stdin.write(oid+b'\n');git.stdin.flush();header=git.stdout.readline().split();assert len(header)==3 and header[1]==b'blob';size=int(header[2]);b=git.stdout.read(size);assert git.stdout.read(1)==b'\n';total+=len(b);hits+=sum(v in b for v in values);pem+=len(pattern.findall(b));objects[oid]=size
+ git.stdin.close();assert git.wait()==0
+for entry in entries:entry['bytes']=objects[entry['oid'].encode()]
+raw=[]
+for f in sorted(A.rglob('*')):
+ if not f.is_file() or str(f.relative_to(P)) in attestations:continue
+ b=f.read_bytes();total+=len(b);hits+=sum(v in b for v in values);pem+=len(pattern.findall(b));raw.append({'path':str(f.relative_to(P)),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
+inventory={'base':'5657d24a4a58916dfca14a29e352ad361dda3319','stagedPayload':sorted(entries,key=lambda e:e['path']),'rawFiles':raw,'selfAttestationsExcluded':sorted(attestations)}
+inventoryBytes=(json.dumps(inventory,indent=2)+'\n').encode()
+assert not any(v in inventoryBytes for v in values) and not pattern.search(inventoryBytes)
+(A/'scan-membership.json').write_bytes(inventoryBytes)
+result={'scope':{'rawRoot':str(A.relative_to(P)),'rawFiles':len(raw),'exactStagedPayloadPaths':len(entries),'uniqueStagedPayloadBlobs':len(objects),'bytesScannedIncludingOverlap':total,'membershipPath':str((A/'scan-membership.json').relative_to(P)),'membershipSha256':hashlib.sha256(inventoryBytes).hexdigest(),'excludedSelfAttestations':sorted(attestations)},'knownOriginalValueCount':6,'actualProviderSecretFiles':len(provider),'task9ProviderSecretFiles':len(provider09),'task10ProviderSecretFiles':len(provider10),'task10ProviderStoreDirectoryCount':sum(1 for f in (P/'.tools/task10-1e48b41fc5c84a98af3a14b51b17884f').rglob('provider-test-*') if f.is_dir()),'fixedTestBearerIsPublicFixtureConstant':True,'uniqueValues':len(values),'exactValueHits':hits,'privatePemHits':pem,'scriptSha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'receiptAndInventoryScannedInMemory':True}
+receipt=(json.dumps(result,indent=2)+'\n').encode();assert not any(v in receipt for v in values) and not pattern.search(receipt)
+(A/'private-scan.json').write_bytes(receipt);print(json.dumps(result));assert hits==0 and pem==0,'Private scan failed; do not print values'
