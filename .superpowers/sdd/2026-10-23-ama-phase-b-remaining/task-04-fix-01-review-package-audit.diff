+  securitySchemes:
+    enterpriseSession:
+      type: apiKey
+      in: cookie
+      name: __Host-AMA_SESSION
+      description: Opaque server session; Secure, HttpOnly, Path=/, SameSite=Lax. No production sign-in or test-login route exists pending the company protocol.
+  schemas:
+    Health:
+      type: object
+      additionalProperties: false
+      required:
+        - status
+      properties:
+        status:
+          type: string
+          enum:
+            - UP
+            - DOWN
+            - OUT_OF_SERVICE
+            - UNKNOWN
+    Actor:
+      type: object
+      additionalProperties: false
+      required:
+        - enterpriseId
+        - status
+        - roles
+      properties:
+        enterpriseId:
+          type: string
+          description: Exact company stable ID; case and trailing spaces are significant
+        status:
+          type: string
+          enum:
+            - ACTIVE
+            - DISABLED
+        roles:
+          type: array
+          uniqueItems: true
+          description: Platform privileges only; never a meeting body override
+          items:
+            type: string
+            enum:
+              - USER
+              - PLATFORM_ADMIN
+    Session:
+      type: object
+      additionalProperties: false
+      required:
+        - actor
+        - csrfToken
+        - expiresAt
+      properties:
+        actor:
+          $ref: '#/components/schemas/Actor'
+        csrfToken:
+          type: string
+        expiresAt:
+          type: string
+          format: date-time
+    BusinessError:
+      type: object
+      additionalProperties: false
+      required:
+        - error
+      properties:
+        error:
+          type: object
+          additionalProperties: false
+          required:
+            - code
+            - message
+            - traceId
+          properties:
+            code:
+              type: string
+              enum:
+                - UNAUTHENTICATED
+                - FORBIDDEN
+                - INVALID_ARGUMENT
+                - IDENTITY_UNAVAILABLE
+                - IDENTITY_PROVIDER_UNAVAILABLE
+                - MEETING_FORBIDDEN
+                - MEETING_CONFLICT
+                - CATEGORY_DICTIONARY_UNAVAILABLE
+                - REQUEST_TOO_LARGE
+                - FILE_PURPOSE_UNAVAILABLE
+                - FILE_CONFLICT
+                - FILE_NOT_FOUND
+                - FILE_STORAGE_UNAVAILABLE
+                - FILE_INVALID_RANGE
+            message:
+              type: string
+            traceId:
+              type: string
