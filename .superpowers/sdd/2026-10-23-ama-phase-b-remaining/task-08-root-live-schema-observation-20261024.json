  "query": "SET SESSION time_zone='+00:00';\nSELECT JSON_OBJECT('kind','engine','row',JSON_OBJECT('version',VERSION(),'timeZone',@@session.time_zone));\nSELECT JSON_OBJECT('kind','history','row',JSON_OBJECT('installed_rank',installed_rank,'version',version,'description',description,'type',type,'script',script,'checksum',checksum,'installed_by',installed_by,'installed_on',installed_on,'execution_time',execution_time,'success',success)) FROM flyway_schema_history ORDER BY installed_rank;\nSELECT JSON_OBJECT('kind','column','row',JSON_OBJECT('TABLE_NAME',TABLE_NAME,'COLUMN_NAME',COLUMN_NAME,'ORDINAL_POSITION',ORDINAL_POSITION,'COLUMN_DEFAULT',COLUMN_DEFAULT,'IS_NULLABLE',IS_NULLABLE,'DATA_TYPE',DATA_TYPE,'COLUMN_TYPE',COLUMN_TYPE,'EXTRA',EXTRA,'CHARACTER_SET_NAME',CHARACTER_SET_NAME,'COLLATION_NAME',COLLATION_NAME)) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='external_operation' AND COLUMN_NAME='reconcile_scan_seq';\nSELECT JSON_OBJECT('kind','index','row',JSON_OBJECT('TABLE_NAME',TABLE_NAME,'INDEX_NAME',INDEX_NAME,'NON_UNIQUE',NON_UNIQUE,'SEQ_IN_INDEX',SEQ_IN_INDEX,'COLUMN_NAME',COLUMN_NAME,'SUB_PART',SUB_PART,'INDEX_TYPE',INDEX_TYPE,'IS_VISIBLE',IS_VISIBLE,'EXPRESSION',EXPRESSION)) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA=DATABASE() AND ((TABLE_NAME='external_operation' AND INDEX_NAME='external_reconcile_scan') OR (TABLE_NAME='durable_task' AND INDEX_NAME='task_input_lookup')) ORDER BY TABLE_NAME,INDEX_NAME,SEQ_IN_INDEX;\n",
