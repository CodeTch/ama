+package ama.api;
+import com.fasterxml.jackson.core.*;import com.fasterxml.jackson.databind.*;import jakarta.servlet.http.HttpServletRequest;import java.io.*;import java.util.*;
+/** Finite strict command normalization shared by replay lookup and the formal closed new branch. */
+final class MinutesSavedWire {
+ private static final ObjectMapper JSON=new ObjectMapper(JsonFactory.builder().enable(StreamReadFeature.STRICT_DUPLICATE_DETECTION).streamReadConstraints(StreamReadConstraints.builder().maxNestingDepth(8).maxStringLength(4194304).maxNumberLength(19).build()).build()).enable(DeserializationFeature.FAIL_ON_TRAILING_TOKENS);
+ record Command(long expected,String[] semantics){}
+ static JsonNode read(HttpServletRequest request)throws IOException{if(request.getContentLengthLong()>8388608)throw new ama.contract.TranscriptContracts.Failure(413,"REQUEST_TOO_LARGE");byte[] bytes;try(var in=request.getInputStream()){bytes=in.readNBytes(8388609);}if(bytes.length>8388608)throw new ama.contract.TranscriptContracts.Failure(413,"REQUEST_TOO_LARGE");JsonNode root;try(var parser=JSON.getFactory().createParser(bytes)){int count=0;while(parser.nextToken()!=null){if(++count>100000)throw new IllegalArgumentException("Too many fields");if(parser.currentToken()==JsonToken.VALUE_STRING)ama.contract.MinutesContracts.scalars(parser.getText());}root=JSON.readTree(bytes);}catch(JsonProcessingException failure){throw new IllegalArgumentException("Malformed minutes command");}if(root==null||!root.isObject())throw new IllegalArgumentException("Object required");return root;}
+ static Command command(HttpServletRequest request,String operation,String selected)throws IOException{var root=read(request);long expected=HttpRevisionTokens.expected(root);var fields=new HashSet<String>(Set.of("expectedRevision","expectedRevisionToken"));var values=new ArrayList<String>();switch(operation){
+  case "MINUTES_ADOPT"->{fields.addAll(Set.of("inputId","inputFingerprint"));Collections.addAll(values,uuid(selected),uuid(text(root,"inputId",false)),text(root,"inputFingerprint",false));ama.contract.MinutesContracts.hash(values.getLast());}
+  case "MINUTES_REJECT","MINUTES_DISPOSE"->values.add(uuid(selected));
+  case "MINUTES_BODY_SAVE"->{fields.addAll(Set.of("sourceRevisionId","title","body","evidenceAnchors"));Collections.addAll(values,uuid(text(root,"sourceRevisionId",false)),text(root,"title",false),text(root,"body",false));anchors(root,values);}
+  case "MINUTES_BODY_RESTORE","MINUTES_SET_RESTORE"->{String field=operation.equals("MINUTES_BODY_RESTORE")?"sourceRevisionId":"sourceSetId";fields.add(field);Collections.addAll(values,uuid(text(root,field,false)),null,null);}
+  case "MINUTES_ELEMENT_EDIT","MINUTES_OPEN_QUESTION"->{fields.addAll(Set.of("sourceSetId","body","evidenceAnchors"));Collections.addAll(values,uuid(text(root,"sourceSetId",false)),uuid(selected),text(root,"body",false));anchors(root,values);}
+  case "MINUTES_ACTION_FIELDS"->{fields.addAll(Set.of("sourceSetId","ownerEnterpriseId","ownerDisplay","dueOn"));Collections.addAll(values,uuid(text(root,"sourceSetId",false)),uuid(selected),null,text(root,"ownerEnterpriseId",true),text(root,"ownerDisplay",true),text(root,"dueOn",true));}
+  case "MINUTES_TEMPLATE"->{fields.add("templateRevisionId");values.add(uuid(text(root,"templateRevisionId",false)));}
+  case "MINUTES_EXCLUSIONS"->{fields.addAll(Set.of("sourceExclusionRevisionId","items"));values.add(uuid(text(root,"sourceExclusionRevisionId",false)));var items=root.get("items");if(items==null||!items.isArray()||items.size()>10000)throw new IllegalArgumentException("Complete bounded items required");var members=new TreeMap<String,List<String>>();for(var item:items){exact(item,Set.of("locatorId","category","reason"));String id=uuid(text(item,"locatorId",false)),category=text(item,"category",false);if(members.put(id+"/"+category,Arrays.asList(id,category,text(item,"reason",true)))!=null)throw new IllegalArgumentException("Duplicate exclusion");}for(var item:members.values())values.addAll(item);}
+  case "MINUTES_REVIEW"->{fields.addAll(Set.of("target","reviewKind","scope","outcome","startToken","endToken"));var target=root.get("target");exact(target,Set.of("kind","id"));String kind=text(target,"kind",false),reviewKind=text(root,"reviewKind",false),scope=text(root,"scope",true),outcome=text(root,"outcome",false),start=optionalCounter(root,"startToken"),end=optionalCounter(root,"endToken");if(!Set.of("BODY","ELEMENT").contains(kind))throw new IllegalArgumentException("Invalid review target");if("ACTION_FIELDS".equals(reviewKind)){if(!"ELEMENT".equals(kind)||scope!=null||!"CONFIRMED".equals(outcome)||start!=null||end!=null)throw new IllegalArgumentException("Invalid accepted-field review");}else if(!"SOURCE_SUPPORT".equals(reviewKind)||scope==null||!Set.of("WHOLE","SPAN").contains(scope)||!Set.of("SUPPORTED","PARTIAL","UNSUPPORTED").contains(outcome)||("WHOLE".equals(scope)?start!=null||end!=null:start==null||end==null||Long.parseLong(end)<=Long.parseLong(start)))throw new IllegalArgumentException("Invalid support review");Collections.addAll(values,kind,uuid(text(target,"id",false)),reviewKind,scope,outcome,start,end);}
+  default->throw new IllegalArgumentException("Unknown minutes operation");}allowed(root,fields);return new Command(expected,values.toArray(String[]::new));}
+ static Map<String,String> discovery(HttpServletRequest request)throws IOException{var root=read(request);exact(root,Set.of("operation","key"));return Map.of("operation",text(root,"operation",false),"key",text(root,"key",false));}
+ private static void anchors(JsonNode root,List<String> values){var anchors=root.get("evidenceAnchors");if(anchors==null||!anchors.isArray()||anchors.size()>10000)throw new IllegalArgumentException("Complete bounded anchors required");var members=new TreeMap<String,List<String>>();for(var anchor:anchors){exact(anchor,Set.of("evidenceId","startToken","endToken"));String id=uuid(text(anchor,"evidenceId",false));if(members.put(id,List.of(id,counter(text(anchor,"startToken",false)),counter(text(anchor,"endToken",false))))!=null)throw new IllegalArgumentException("Duplicate evidence anchor");}for(var item:members.values())values.addAll(item);}
+ static String counter(String value){if(value.length()>19||!value.matches("0|[1-9][0-9]*"))throw new IllegalArgumentException("Canonical counter required");try{long n=Long.parseLong(value);if(n<0||n>Long.MAX_VALUE-1)throw new IllegalArgumentException("Counter out of range");return value;}catch(NumberFormatException e){throw new IllegalArgumentException("Counter out of range");}}
+ private static String optionalCounter(JsonNode node,String name){return node.has(name)?counter(text(node,name,false)):null;}
+ private static String text(JsonNode node,String name,boolean nullable){var value=node.get(name);if(value==null)throw new IllegalArgumentException("Required field missing");if(value.isNull()&&nullable)return null;if(!value.isTextual())throw new IllegalArgumentException("Text required");ama.contract.MinutesContracts.scalars(value.textValue());return value.textValue();}
+ private static String uuid(String value){ama.contract.MinutesContracts.uuid(value);return value;}
+ private static void exact(JsonNode node,Set<String> fields){if(node==null||!node.isObject()||node.size()!=fields.size())throw new IllegalArgumentException("Exact object required");allowed(node,fields);}
+ private static void allowed(JsonNode node,Set<String> fields){node.fieldNames().forEachRemaining(name->{if(!fields.contains(name))throw new IllegalArgumentException("Unknown field");});}
+}
