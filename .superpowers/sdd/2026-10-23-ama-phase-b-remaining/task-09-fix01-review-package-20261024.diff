+  assertTrue(refs.stream().filter(r->r.artifactType()==ArtifactType.PROMPT_CONFIG).count()>=2);assertTrue(refs.stream().filter(r->r.artifactType()==ArtifactType.MODEL_CONFIG).count()>=2);String task=UUID.randomUUID().toString();var spec=new TaskSpec("MINUTES_GENERATE_V1","MINUTES_GENERATE",new SubjectRef("MEETING",draft.meetingId()),ama.minutes.MinutesGenerateProducer.compute(draft.meetingId(),draft.inputId(),binding.fingerprint(),4,0,B,()->false),new TypedRef("GENERATION_INPUT",draft.inputId()),binding.fingerprint(),4,0,0,3);
