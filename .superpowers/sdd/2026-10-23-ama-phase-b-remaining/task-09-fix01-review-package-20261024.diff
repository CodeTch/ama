+  var d=graph.discovery();var root=new LinkedHashMap<>(d.root());root.put("minutes_revision_id",UUID.randomUUID().toString());var later=new MinutesGraphCapture.Graph(new MinutesGraphDiscovery.Discovery(d.meeting(),d.kind(),d.selected(),root,d.tables(),d.memberships(),d.identities(),d.selectors()),graph.rows(),graph.auxiliary());
+  var replay=assertDoesNotThrow(()->MinutesCandidateGraphPlan.prepareReceipt(request.spec,request.input.actor().enterpriseId(),output,binding.catalog(),later,request.input.budget(),request.taskId));assertEquals(original.candidateId(),replay.candidateId());assertEquals(original.rows(body.number("revision"),set.number("revision")),replay.rows(body.number("revision"),set.number("revision")));
