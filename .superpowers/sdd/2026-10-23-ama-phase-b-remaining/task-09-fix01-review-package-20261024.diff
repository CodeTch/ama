+  var missing=new ArrayList<>(roots);missing.removeIf(v->{var r=ama.config.WireValues.ref(v);return r.artifactType()==ArtifactType.PROMPT_CONFIG&&r.version().equals(draft.promptVersion());});assertThrows(Failure.class,()->check(replace(manifest,"roots",new Sequence(missing)),replace(envelope,"roots",new Sequence(missing)),spec,task,input));
+  var altered=new ArrayList<>(roots);altered.set(0,replace((ObjectValue)roots.getFirst(),"sha256",string("0".repeat(64))));assertThrows(Failure.class,()->check(replace(manifest,"roots",new Sequence(altered)),envelope,spec,task,input));
