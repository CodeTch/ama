+  var manifest=object(field("protocolVersion",string(ama.model.ControlledMinutesProtocol.VERSION)),field("providerId",string("CONTROLLED_HTTP_V1")),field("modelIdentity",string(ama.model.ControlledMinutesProtocol.MODEL)),field("taskId",string(task)),field("inputId",string(draft.inputId())),field("inputFingerprint",string(binding.fingerprint())),field("requesterId",string(owner)),field("logicalBusinessKey",string("minutes:"+draft.inputId())),field("payloadSha256",string(ph)),field("archiveIndexSha256",string(pin)),field("roots",new Sequence(roots)),field("base",object(field("businessVersion",number(4)),field("cancelEpoch",number(0)))));
+  var input=new LinkedHashMap<String,Object>();input.put("meeting_id",draft.meetingId());input.put("input_fingerprint",binding.fingerprint());input.put("base_revision",4L);input.put("prompt_version",draft.promptVersion());input.put("model_config_version",draft.modelVersion());input.put("scope","FULL");input.put("target_element_id",null);input.put("material_snapshot_id",null);
