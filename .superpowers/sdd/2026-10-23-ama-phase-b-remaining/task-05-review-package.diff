diff --git a/backend/adapters/src/main/java/ama/storage/ConfiguredBackends.java b/backend/adapters/src/main/java/ama/storage/ConfiguredBackends.java
new file mode 100644
index 0000000..09653a2
--- /dev/null
+++ b/backend/adapters/src/main/java/ama/storage/ConfiguredBackends.java
@@ -0,0 +1,95 @@
+package ama.storage;
+import ama.storage.internal.ServiceTls;
+import ama.storage.s3.*;
+import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
+import org.springframework.core.env.PropertyResolver;
+import java.net.URI;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.*;
+/** Same physical backend mapping for API and the separate Worker process. */
+public final class ConfiguredBackends {
+ private ConfiguredBackends(){}
+ public static FileBackendDefinitions read(PropertyResolver env)throws Exception {
+        var definitions = new ArrayList<FileBackendCatalog.Backend>();
+        var aliases = new HashMap<String, String>();
+        for (String alias : env.getProperty("files.backends", "").split(",")) {
+            if (alias.isBlank()) continue;
+            ama.contract.FileContracts.code(alias);
+            String prefix = "files." + alias + ".";
+            String type = env.getRequiredProperty(prefix + "type"),
+                    id = env.getRequiredProperty(prefix + "id");
+            FileBackendCatalog.Backend backend;
+            long revision = env.getRequiredProperty(prefix + "revision", Long.class);
+            String status = env.getProperty(prefix + "status", "WRITABLE");
+            if (type.equals("local")) {
+                var local =
+                        new ManagedBackendId.Local(
+                                env.getRequiredProperty(prefix + "service-origin"),
+                                env.getRequiredProperty(prefix + "volume-id"),
+                                env.getRequiredProperty(prefix + "relative-root"),
+                                env.getRequiredProperty(prefix + "filesystem"));
+                ManagedBackendId.require(id, local);
+                backend =
+                        ManagedBackendAdapters.local(
+                                id,
+                                local,
+                                ServiceTls.context(
+                                        Path.of(env.getRequiredProperty(prefix + "key-store")),
+                                        env.getRequiredProperty(prefix + "key-store-password")
+                                                .toCharArray(),
+                                        Path.of(env.getRequiredProperty(prefix + "trust-store")),
+                                        env.getRequiredProperty(prefix + "trust-store-password")
+                                                .toCharArray()),
+                                revision,
+                                status);
+            } else if (type.equals("s3")) {
+                var s3 =
+                        new ManagedBackendId.S3(
+                                env.getRequiredProperty(prefix + "endpoint"),
+                                env.getRequiredProperty(prefix + "region"),
+                                env.getRequiredProperty(prefix + "data-bucket"),
+                                env.getRequiredProperty(prefix + "control-bucket"),
+                                env.getProperty(prefix + "path-style", Boolean.class, true),
+                                env.getProperty(prefix + "key-budget", Integer.class, 1024));
+                ManagedBackendId.require(id, s3);
+                if (!URI.create(s3.endpoint()).getScheme().equals("https"))
+                    throw new IllegalArgumentException("Production S3 requires HTTPS");
+                var config =
+                        new S3Config(
+                                id,
+                                URI.create(s3.endpoint()),
+                                s3.region(),
+                                s3.dataBucket(),
+                                s3.controlBucket(),
+                                () ->
+                                        AwsBasicCredentials.create(
+                                                env.getRequiredProperty(prefix + "access-key"),
+                                                env.getRequiredProperty(prefix + "secret-key")),
+                                s3.pathStyle(),
+                                s3.keyBudget(),
+                                env.getProperty(
+                                        prefix + "chunk-bytes", Integer.class, 8 * 1024 * 1024),
+                                5L * 1024 * 1024,
+                                5L * 1024 * 1024 * 1024,
+                                10000,
+                                env.getRequiredProperty(
+                                        prefix + "maximum-object-bytes", Long.class),
+                                env.getProperty(prefix + "admission", Integer.class, 8),
+                                Duration.ofMillis(
+                                        env.getProperty(
+                                                prefix + "timeout-ms", Long.class, 20000L)));
+                backend = ManagedBackendAdapters.s3(config, revision, status);
+            } else throw new IllegalArgumentException("Unknown configured file backend");
+            if (aliases.put(alias, id) != null)
+                throw new IllegalArgumentException("Duplicate backend alias");
+            definitions.add(backend);
+        }
+        String selected = env.getProperty("files.default");
+        if (selected != null && !aliases.containsKey(selected))
+            throw new IllegalArgumentException("Unknown configured default");
+        return new FileBackendDefinitions(
+                definitions, selected == null ? null : aliases.get(selected));
+
+ }
+}
diff --git a/backend/adapters/src/main/java/ama/storage/DeadlineInputStream.java b/backend/adapters/src/main/java/ama/storage/DeadlineInputStream.java
new file mode 100644
index 0000000..9a699bd
--- /dev/null
+++ b/backend/adapters/src/main/java/ama/storage/DeadlineInputStream.java
@@ -0,0 +1,41 @@
+package ama.storage;
+import java.io.*;
+import java.time.Duration;
+import java.util.Objects;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.*;
+/** A finite transport lifetime, installed before metadata or error bodies are consumed. */
+public final class DeadlineInputStream extends InputStream {
+ private enum State { OPEN,EOF_CLOSED,CLOSED,ABORTED }
+ private static final Semaphore CAPACITY=new Semaphore(1024);
+ private static final ScheduledThreadPoolExecutor TIMER;
+ static {TIMER=new ScheduledThreadPoolExecutor(2,r->{var t=new Thread(r,"ama-body-deadline");t.setDaemon(true);return t;});TIMER.setRemoveOnCancelPolicy(true);}
+ private final InputStream source;private final Runnable release;private final long deadline;
+ private final AtomicReference<State> state=new AtomicReference<>(State.OPEN);
+ private volatile ScheduledFuture<?> timer;private volatile IOException closeFailure;
+ public DeadlineInputStream(InputStream source,Duration lifetime,Runnable release){
+  this.source=Objects.requireNonNull(source);this.release=Objects.requireNonNull(release);
+  if(lifetime==null||lifetime.isNegative()||lifetime.isZero()||lifetime.compareTo(Duration.ofHours(1))>0){release.run();throw new IllegalArgumentException("Finite stream lifetime required");}
+  deadline=System.nanoTime()+lifetime.toNanos();
+  if(!CAPACITY.tryAcquire()){release.run();throw new IllegalStateException("Body lifetime capacity exhausted");}
+  timer=TIMER.schedule(()->terminate(State.ABORTED),lifetime.toNanos(),TimeUnit.NANOSECONDS);
+ }
+ private void terminate(State terminal){
+  if(!state.compareAndSet(State.OPEN,terminal))return;
+  var scheduled=timer;if(scheduled!=null)scheduled.cancel(false);
+  try{release.run();}catch(RuntimeException failure){closeFailure=new IOException("STORAGE_UNAVAILABLE");}finally{CAPACITY.release();}
+ }
+ private void check()throws IOException{
+  if(System.nanoTime()-deadline>=0&&state.get()==State.OPEN)terminate(State.ABORTED);
+  if(state.get()==State.ABORTED||state.get()==State.CLOSED||closeFailure!=null)throw new IOException("STORAGE_UNAVAILABLE");
+ }
+ @Override public int read()throws IOException{byte[] b=new byte[1];int n=read(b,0,1);return n<0?-1:b[0]&255;}
+ @Override public int read(byte[] b,int off,int len)throws IOException{
+  Objects.checkFromIndexSize(off,len,b.length);if(len==0)return 0;check();if(state.get()==State.EOF_CLOSED)return -1;
+  try{
+   int n=source.read(b,off,len);check();
+   if(n<0){terminate(State.EOF_CLOSED);check();}return n;
