+
+    void startApp() {
+        app =
+                new SpringApplicationBuilder(ApiApplication.class)
+                        .initializers(
+                                context -> {
+                                    var c = (GenericApplicationContext) context;
+                                    c.registerBean(
+                                            "registryDataSource",
+                                            javax.sql.DataSource.class,
