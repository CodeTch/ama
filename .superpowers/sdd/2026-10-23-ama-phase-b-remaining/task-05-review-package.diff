+        var created = call("POST", "/meetings", "{}", UUID.randomUUID().toString(), null);
+        assertEquals(201, created.statusCode(), created.body());
+        meeting = body(created).get("id").asText();
+        var init =
+                call(
+                        "POST",
+                        "/meetings/" + meeting + "/uploads",
