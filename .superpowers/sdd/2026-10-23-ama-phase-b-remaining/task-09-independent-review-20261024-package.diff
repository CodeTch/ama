+package ama.storage;
+import ama.transcript.*;import ama.model.*;import ama.task.*;import ama.contract.ExternalContracts.*;import java.util.*;import java.util.concurrent.atomic.*;import java.nio.file.*;import static org.junit.jupiter.api.Assertions.*;
+/** Fails real JDBC calls inside the production observer; recovery uses only the original provider fact. */
+abstract class Task09GenerationRollbackFixture extends Task09GenerationRichIT {
+ final AtomicBoolean writing=new AtomicBoolean(),injected=new AtomicBoolean();abstract String failurePrefix();
+ @Override javax.sql.DataSource createSource(){return new Task09TraceSource(ama.minutes.Task09Source.open());}
+ @Override String expectedImmediateTaskState(){return "RECONCILING";}
+ @Override void beforeWorker(String task){((Task09TraceSource)source).before=sql->{if(!Thread.currentThread().getName().startsWith("ama-work-MINUTES_GENERATE"))return;if(sql.startsWith("INSERT INTO minutes_revision"))writing.set(true);if(writing.get()&&sql.startsWith(failurePrefix())&&injected.compareAndSet(false,true))throw new IllegalStateException("TASK09_INJECTED_OBSERVER_ROLLBACK");};}
+ @Override void afterWorker(String task,MinutesExternalPreparation preparation,ControlledMinutesClient client,JdbcExternalOperations operations,JdbcModelPermitPool permits,Throwable failure)throws Exception {
+  ((Task09TraceSource)source).before=sql->{};assertTrue(injected.get());assertNotNull(failure);var before=j.queryForMap("SELECT t.state task_state,e.id execution_id,e.state execution_state,o.id operation_id,o.state operation_state,r.settled_at FROM durable_task t JOIN external_execution e ON e.task_id=t.id JOIN external_operation o ON o.id=e.operation_id JOIN model_reservation r ON r.execution_id=e.id WHERE t.id=?",task);assertEquals("RECONCILING",before.get("task_state"));assertEquals("MARKED",before.get("execution_state"));assertEquals("MARKED",before.get("operation_state"));assertNull(before.get("settled_at"));
+  for(String table:List.of("generation_candidate","minutes_revision","element_set","source_locator","result_review"))assertEquals(0,j.queryForObject("SELECT COUNT(*) FROM "+table+" WHERE meeting_id=?",Integer.class,meeting),table);assertEquals(0,j.queryForObject("SELECT COUNT(*) FROM audit_event WHERE resource_id=? AND action='MINUTES_GENERATION_COMPLETED'",Integer.class,meeting));assertEquals(0,j.queryForObject("SELECT COUNT(*) FROM task_outbox WHERE task_id=? AND event_type='TASK_SUCCEEDED'",Integer.class,task));assertEquals(0,j.queryForObject("SELECT COUNT(*) FROM task_attempt WHERE task_id=? AND ended_at IS NOT NULL",Integer.class,task));var files=providerSeals();Files.writeString(receipt.resolve("actual-observer-rollback.json"),json.writeValueAsString(Map.of("task",task,"failurePrefix",failurePrefix(),"execution",before.get("execution_id"),"operation",before.get("operation_id"),"graphRows",0,"completedAudit",0,"completedEvent",0,"attemptEnded",false,"permitSettled",false,"providerFiles",files)));
+  recover(task,preparation,client,operations,permits,before);assertEquals(files,providerSeals());assertEquals("SUCCEEDED",j.queryForObject("SELECT state FROM durable_task WHERE id=?",String.class,task));assertEquals(1,j.queryForObject("SELECT COUNT(*) FROM external_execution WHERE task_id=?",Integer.class,task));
+ }
+ void recover(String task,MinutesExternalPreparation preparation,ControlledMinutesClient client,JdbcExternalOperations operations,JdbcModelPermitPool permits,Map<String,Object> before)throws Exception {
+  ama.contract.ExternalContracts.OperationToken token=null;long end=System.nanoTime()+java.util.concurrent.TimeUnit.SECONDS.toNanos(35);while(token==null&&System.nanoTime()<end){token=operations.claimReconciliation("TASK09_ROLLBACK_RECOVERY").orElse(null);if(token==null)Thread.sleep(100);}assertNotNull(token);assertEquals(before.get("execution_id"),token.executionId());assertEquals(before.get("operation_id"),token.operationId());var request=preparation.prepareLookup(token);var wire=client.prepare(request.body(token.executionId()),request.envelope());var remote=client.lookup(wire,NEVER);assertEquals("SUCCEEDED",remote.state());assertEquals(ObservationResult.APPLIED,operations.observePrepared(token,preparation.accept(request,token,wire,remote,NEVER)));assertEquals(1,permits.recoverSettlements(64));Files.writeString(receipt.resolve("actual-observer-rollback-recovery.json"),json.writeValueAsString(Map.of("task",task,"execution",token.executionId(),"resultId",remote.resultId(),"lookupOnly",true,"permitSettled",true)));
+ }
+ Map<String,String> providerSeals()throws Exception {var result=new TreeMap<String,String>();try(var files=Files.walk(providerStore)){for(var file:files.filter(Files::isRegularFile).toList()){assertTrue(Files.size(file)<=16777216);result.put(providerStore.relativize(file).toString(),HexFormat.of().formatHex(java.security.MessageDigest.getInstance("SHA-256").digest(Files.readAllBytes(file))));}}return result;}
+}
