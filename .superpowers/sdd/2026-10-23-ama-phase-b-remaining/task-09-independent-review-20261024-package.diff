+  try{long end=System.nanoTime()+java.util.concurrent.TimeUnit.SECONDS.toNanos(10);while(!Files.exists(ready)&&process.isAlive()&&System.nanoTime()<end)Thread.sleep(20);assertTrue(process.isAlive()&&Files.exists(ready),"Original provider store restart failed");assertEquals(providerPort,Integer.parseInt(Files.readString(ready)));replayAfterRestart(candidate,preparation,client,operations);assertEquals(before,seals());Files.writeString(receipt.resolve("fresh-process-same-fact.json"),json.writeValueAsString(Map.of("candidate",candidate.get("id"),"providerPid",process.pid(),"parentPid",ProcessHandle.current().pid(),"samePort",providerPort,"heapMiB",64,"processors",2,"sameFiles",before,"GETOnlyAfterRestart",true)));}
