+ final ServerSocket listener;final int upstream;final Runnable afterPost;Runnable beforePost=()->{};java.util.function.Consumer<Socket> postSocket=socket->{};boolean dropPostResponse;final AtomicReference<Throwable> failure=new AtomicReference<>();final AtomicInteger posts=new AtomicInteger(),gets=new AtomicInteger();final Set<Socket> sockets=ConcurrentHashMap.newKeySet();final ExecutorService workers=Executors.newFixedThreadPool(2);final Thread accept;volatile boolean closed;
+ Task09ControlledRelay(int upstream,Runnable afterPost)throws IOException{this.upstream=upstream;this.afterPost=afterPost;listener=new ServerSocket();listener.bind(new InetSocketAddress("127.0.0.1",0),2);accept=new Thread(()->{while(!closed)try{Socket socket=listener.accept();sockets.add(socket);workers.execute(()->serve(socket));}catch(Exception e){if(!closed)failure.compareAndSet(null,e);}},"task09-controlled-relay");accept.start();}
+ int port(){return listener.getLocalPort();}
+ void serve(Socket incoming){try(incoming;var target=new Socket("127.0.0.1",upstream)){incoming.setSoTimeout(5000);target.setSoTimeout(5000);var input=incoming.getInputStream();var header=new ByteArrayOutputStream();int tail=0;while(tail!=0x0d0a0d0a){int b=input.read();if(b<0||header.size()>=16384)throw new IOException("Bounded relay header");header.write(b);tail=(tail<<8)|b;}String text=header.toString(StandardCharsets.US_ASCII);boolean post=text.startsWith("POST ");int length=0;for(String line:text.split("\r\n"))if(line.toLowerCase(Locale.ROOT).startsWith("content-length:"))length=Integer.parseInt(line.substring(15).trim());if(length<0||length>16777216)throw new IOException("Bounded relay body");byte[] body=input.readNBytes(length);if(body.length!=length)throw new EOFException();if(post)beforePost.run();String forwarded=text.replace("Host: 127.0.0.1:"+port(),"Host: 127.0.0.1:"+upstream);target.getOutputStream().write(forwarded.getBytes(StandardCharsets.US_ASCII));target.getOutputStream().write(body);target.getOutputStream().flush();byte[] response=target.getInputStream().readNBytes(8388608+32769);if(response.length>8388608+32768)throw new IOException("Bounded relay response");if(post){posts.incrementAndGet();afterPost.run();postSocket.accept(incoming);}else gets.incrementAndGet();if(!post||!dropPostResponse){incoming.getOutputStream().write(response);incoming.getOutputStream().flush();}}catch(Throwable e){failure.compareAndSet(null,e);}finally{sockets.remove(incoming);}}
