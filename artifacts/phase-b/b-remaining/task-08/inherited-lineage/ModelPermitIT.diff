  @Test void concurrentAdmissionRetainsNullDeadlineAfterTimeout()throws Exception{var p=pool(1,1,true,ModelConfiguration.CutoffPolicy.EXPLICIT_SETTLEMENT);p.configure();var a=token();var b=token();var go=new CountDownLatch(1);try(var threads=Executors.newFixedThreadPool(2)){var x=threads.submit(()->{go.await();return p.acquire(a,model,null);});var y=threads.submit(()->{go.await();return p.acquire(b,model,null);});go.countDown();var one=x.get(5,TimeUnit.SECONDS);var two=y.get(5,TimeUnit.SECONDS);assertEquals(1,(one.isPresent()?1:0)+(two.isPresent()?1:0));var permit=one.orElseGet(two::orElseThrow);f.j.update("UPDATE external_operation SET reconcile_expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND WHERE id=?",one.isPresent()?a.operationId():b.operationId());assertFalse(p.settled(permit));assertEquals(1,f.j.queryForObject("SELECT COUNT(*) FROM model_reservation WHERE model=? AND safe_deadline IS NULL AND settled_at IS NULL",Integer.class,model));}}
