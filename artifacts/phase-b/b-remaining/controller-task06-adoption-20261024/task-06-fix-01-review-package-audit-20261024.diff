+ }
+ private static Long exact(ResultSet r,String name)throws SQLException{var n=r.getBigDecimal(name);try{return n==null?null:n.longValueExact();}catch(ArithmeticException e){throw fail(PROVENANCE_UNAVAILABLE);}}
+}
