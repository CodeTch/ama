+  assertThrows(Failure.class,()->limits.ledger(A,new CanonicalBudget(10000,32,3,1000,1000),()->false).row(2));
+  assertThrows(Failure.class,()->limits.ledger(A,new CanonicalBudget(10000,32,10000,1000,1),()->false).row(2));
