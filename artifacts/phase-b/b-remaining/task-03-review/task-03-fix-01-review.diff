+before={p:{str(x) for x in p.iterdir()} if p.exists() else set() for p in parents}
+children={}
+proc=subprocess.Popen(args,cwd=root,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+while True:
